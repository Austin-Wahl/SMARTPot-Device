#include <DHTesp.h>     // TEMPERATURE SENSOR LIB
#include <BLEDevice.h>  // BLE LIB
#include <BLEUtils.h>   // BLE LIB
#include <BLEServer.h>  // BLE LIB
#include "BLECallbacks.cpp"

#define TEMP_SENSOR_PIN 23
#define SENSOR_READ_DURATION_MS 5000  // Time in MS between sensor readings
#define BLE_NAME "SmartPot"
#define BLE_SERVICE_UUID "6360ec7b-a2b6-41d2-87c6-be45caf92838"
#define BLE_CHARACTERISTIC_UUID "46f45f15-b963-4e4e-bde9-6a9a677df4b4"

// Method signatures
void bluetoothThreadEntry(void *pvParameters);
void sensorThreadEntry(void *pvParameters);
void bluetoothSetup();

// Global Variables 
DHTesp dht;

void setup() {
  Serial.begin(115200);
  dht.setup(TEMP_SENSOR_PIN, DHTesp::DHT11);
  bluetoothSetup();

  // xTaskCreatePinnedToCore(bluetoothThreadEntry, "Bluetooth Thread", 4096, NULL, 1, NULL, 0);
  xTaskCreatePinnedToCore(sensorThreadEntry, "Sensor Thread", 4096, NULL, 2, NULL, 1);
}

void loop() {

}

// Bluetooth threading
void bluetoothThreadEntry(void *pvParameters) {
  // Run setup once 
  Serial.println("Bluetooth thread");
}

// Bluetooth configuration
void bluetoothSetup() {

  // Set name
  BLEDevice::init(BLE_NAME);

  // Create server
  BLEServer *pServer = BLEDevice::createServer();

  // Create Service 
  BLEService *pService = pServer->createService(BLE_SERVICE_UUID);

  // Create Characteristic 
  BLECharacteristic *pCharacteristic = pService->createCharacteristic(BLE_CHARACTERISTIC_UUID, BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_WRITE);

  BLECallbacks *cb = new BLECallbacks();
  pServer->setCallbacks(cb);

  pCharacteristic->setValue("Hello World says Neil");
  pService->start();
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(BLE_SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  pAdvertising->setMinPreferred(0x06); 
  pAdvertising->setMinPreferred(0x12);
  BLEDevice::startAdvertising();

}

// Sensor threading
void sensorThreadEntry(void *pvParameters) {
 while(1) {
    auto d = dht.getTempAndHumidity();
    Serial.printf("Temp: %.1f°C  Humidity: %.1f%%\n", d.temperature, d.humidity);
    delay(SENSOR_READ_DURATION_MS);
  }
}
